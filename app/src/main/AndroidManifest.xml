<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qihang.aod"
    android:versionCode="20261111"
    android:versionName="1.0.3">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.android.settings" />
        <package android:name="com.flyme.alivewallpaper" />
        <package android:name="com.miui.miwallpaper" />
        <package android:name="com.android.thememanager" />
        <package android:name="com.miui.aod" />
        <!-- Android 11+ 包可见性：要能查到/直达系统相册 -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <package android:name="com.miui.gallery" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:directBootAware="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 二级菜单：动态壁纸库 / 编辑 / 通知光效（占位） -->
        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|uiMode" />
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|uiMode" />
        <activity
            android:name=".PhotoCropActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|uiMode" />
        <activity
            android:name=".NotificationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|uiMode" />

        <service
            android:name=".QihangWallpaper"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/qihang_wallpaper" />
        </service>

        <!-- 桌面槽位：同一套实现、独立 ComponentName（见 QihangHomeWallpaper 注释）。
             系统会重置「同一组件」占用的另一侧，两侧必须是不同组件才能共存。 -->
        <service
            android:name=".QihangHomeWallpaper"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/qihang_wallpaper" />
        </service>

        <provider
            android:name=".ClockConfigProvider"
            android:authorities="com.qihang.aod.clockconfig"
            android:exported="true"
            android:directBootAware="true" />

        <provider
            android:name=".WallpaperPreviewProvider"
            android:authorities="com.qihang.aod.wallpaperpreview"
            android:exported="true"
            android:directBootAware="true" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_desc" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
